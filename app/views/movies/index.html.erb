<div id="app" class="container-fluid px-4 py-4">
  <div class="toolbar d-flex flex-nowrap align-items-center gap-3 mb-3 overflow-auto">

    <div class="form-floating tb-language">
      <%= select_tag :locale,
            options_for_select(@locales.map { |l| [l[:label], l[:code]] }),
            class: "form-select" %>
      <label for="locale" data-i18n="language"><%= @ui["language"] %></label>
    </div>

    <div class="form-floating tb-seed">
      <input id="seed" class="form-control" inputmode="numeric" placeholder="Seed" value="<%= @seed %>">
      <label for="seed" data-i18n="seed"><%= @ui["seed"] %></label>
      <button id="random-seed" type="button" class="tb-icon-btn"
        data-i18n-title="random_seed" title="<%= @ui['random_seed'] %>"
        aria-label="<%= @ui['random_seed'] %>">&#8644;
      </button>
    </div>

    <div class="tb-likes">
      <label for="likes" class="tb-likes-label">
        <span data-i18n="likes"><%= @ui["likes"] %></span> <output id="likes-output">3</output>
      </label>
      <input id="likes" type="range" class="form-range" autocomplete="off"
        min="0" max="10" step="0.1" value="3">
    </div>

    <div class="form-floating tb-reviews">
      <input id="reviews" type="number" class="form-control" autocomplete="off"
        min="0" max="10" step="0.1" placeholder="Review" value="2">
      <label for="reviews" data-i18n="reviews"><%= @ui["reviews"] %></label>
    </div>
    <div class="btn-group tb-view ms-auto" id="view-switch" role="group" aria-label="View">
      <button type="button" class="btn btn-primary active" data-view="table"
              data-i18n-title="table_view" title="<%= @ui['table_view'] %>">&#9638;
      </button>
      <button type="button" class="btn btn-outline-primary" data-view="gallery"
              data-i18n-title="gallery_view" title="<%= @ui['gallery_view'] %>">&#9636;
      </button>
    </div>
  </div>
  <div id="table-view">
    <table class="table table-hover align-middle">
      <thead>
        <tr><th class="text-nowrap">#</th>
          <th data-i18n="col_genre"><%= @ui["col_genre"] %></th>
            <th data-i18n="col_title"><%= @ui["col_title"] %></th>
            <th data-i18n="col_cast"><%= @ui["col_cast"] %></th>
            <th class="text-end" data-i18n="col_year"><%= @ui["col_year"] %>
          </th>
        </tr>
      </thead>
    </table>
    <nav id="pagination" aria-label="Pages"></nav>
  </div>
  <div id="gallery-view" hidden>
    <div id="gallery-grid" class="row g-3 align-items-start"></div>
    <div id="gallery-sentinel" class="py-4"></div>
  </div>
</div>
